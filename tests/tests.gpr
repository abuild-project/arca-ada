with "test_dependencies";

project Tests is

   Coverage := external ("ARCA_COVERAGE", "disabled");
   for Languages use ("Ada");
   for Source_Dirs use (".", "../src");
   for Main use
     ("cpio_driver.adb", "tar_driver.adb", "arca-copy_checks.adb",
      "unit_runner.adb", "unit_probe.adb");

   case Coverage is
      when "enabled" =>
         for Object_Dir use "obj-coverage";
         for Exec_Dir use "bin-coverage";
      when others =>
         for Object_Dir use "obj";
         for Exec_Dir use "bin";
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat12", "-gnatwa", "-gnatwe", "-gnatf", "-gnato", "-g");
      case Coverage is
         when "enabled" =>
            for Default_Switches ("Ada") use
              Compiler'Default_Switches ("Ada") &
              ("-O0", "-fprofile-arcs", "-ftest-coverage");
         when others => null;
      end case;
   end Compiler;

   package Linker is
      case Coverage is
         when "enabled" =>
            for Default_Switches ("Ada") use ("--coverage");
         when others => null;
      end case;
   end Linker;

end Tests;
