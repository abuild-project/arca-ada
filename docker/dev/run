#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -euo pipefail

platform=linux/amd64
run_as_root=false

usage()
{
    printf '%s\n' \
        "Usage: $0 [--root] [--platform PLATFORM] IMAGE [COMMAND [ARGUMENT]...]" \
        "PLATFORM defaults to linux/amd64; linux/arm64 can also be selected."
}

invalid()
{
    printf '%s\n' "$1" >&2
    usage >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --platform)
            if [[ $# -lt 2 || $2 == --* ]]; then
                invalid 'Expected a value after --platform'
            fi
            platform=$2
            shift 2
            ;;
        --platform=*)
            platform=${1#*=}
            shift
            ;;
        --root)
            run_as_root=true
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*) invalid "Unknown run option: $1" ;;
        *) break ;;
    esac
done

case $platform in
    linux/amd64|linux/arm64) ;;
    *) invalid "Unsupported platform: $platform" ;;
esac
[[ $# -gt 0 && -n $1 ]] || invalid 'An image is required'

if ! $run_as_root && [[ $(id -u) -eq 0 ]]; then
    printf '%s\n' 'Run as a regular user; --root is an explicit exception' >&2
    exit 1
fi

image=$1
shift
script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(CDPATH='' cd -- "$script_dir/../.." && pwd -P)

docker_args=(run --platform "$platform" --rm)
if $run_as_root; then
    docker_args+=(--user 0:0 --env HOME=/root)
else
    docker_args+=(--user "$(id -u):$(id -g)" --env HOME=/tmp)
fi
if [[ $# -eq 0 ]]; then
    set -- bash
    docker_args+=(--interactive)
    if [[ -t 0 && -t 1 ]]; then
        docker_args+=(--tty)
    fi
fi

exec docker "${docker_args[@]}" \
    --mount "type=bind,source=$repo_root,target=/work" \
    --workdir /work \
    "$image" "$@"
