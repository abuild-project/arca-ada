with "arca";

project CLI is
   Coverage := external ("ARCA_CLI_COVERAGE", "disabled");
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");
   for Main use ("arca_main.adb");

   case Coverage is
      when "enabled" =>
         for Object_Dir use "obj-coverage";
         for Exec_Dir use "bin-coverage";
      when others =>
         for Object_Dir use "obj";
         for Exec_Dir use "bin";
   end case;

   package Builder is
      for Executable ("arca_main.adb") use "arca";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat12", "-gnatwa", "-gnatwe", "-gnatf", "-gnato",
         "-gnatVa", "-fstack-check", "-gnateE", "-g",
         "-gnatygAdISuxM80");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic", "-g");
      case Coverage is
         when "enabled" =>
            for Default_Switches ("Ada") use
              Compiler'Default_Switches ("Ada") &
              ("-O0", "-fprofile-arcs", "-ftest-coverage");
            for Default_Switches ("C") use
              Compiler'Default_Switches ("C") &
              ("-O0", "-fprofile-arcs", "-ftest-coverage");
         when others =>
            null;
      end case;
   end Compiler;

   package Linker is
      case Coverage is
         when "enabled" =>
            for Default_Switches ("Ada") use ("--coverage");
         when others =>
            null;
      end case;
   end Linker;
end CLI;
