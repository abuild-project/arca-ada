-- SPDX-License-Identifier: LGPL-2.1-or-later

library project Arca is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "arca";
   for Library_Kind use "static";
   for Library_Interface use ("arca", "arca.cpio");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat12", "-gnatwa", "-gnatwe", "-gnatf", "-gnato");
   end Compiler;

   package Install is
      for Artifacts ("share/doc/arca") use ("LICENSE", "COPYRIGHT");
   end Install;

end Arca;
