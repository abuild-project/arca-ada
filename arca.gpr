--  SPDX-License-Identifier: GPL-2.0-or-later

library project Arca is

   type Build_Mode_Type is ("release", "validation");
   Build_Mode : Build_Mode_Type := external ("ARCA_BUILD_MODE", "release");

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "arca";
   for Library_Kind use "static";
   for Library_Interface use ("arca", "arca.cpio", "arca.tar");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat12", "-gnatwa", "-gnatf", "-gnato", "-gnatVa",
         "-fstack-check", "-gnateE");
      case Build_Mode is
         when "validation" =>
            for Default_Switches ("Ada") use
              Compiler'Default_Switches ("Ada") &
              ("-gnatwe", "-gnatygAdISuxM80");
         when "release" =>
            null;
      end case;
   end Compiler;

   package Install is
      for Artifacts ("share/doc/arca") use ("LICENSE", "COPYRIGHT");
   end Install;

end Arca;
